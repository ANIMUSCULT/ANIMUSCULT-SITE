Dialogue: 2,0:00:00.00,0:00:02.60,Hook,,0,0,0,,{\fad(80,150)\t(0,250,\fscx106\fscy106)}THE DOLLS\NWOKE THEM\NAT MIDNIGHT
Dialogue: 1,0:00:00.00,0:02:12.74,Tag,,0,0,0,,SWINE · PART 3 OF 8
Dialogue: 0,0:00:00.00,0:00:01.26,Cap,,0,0,0,,EVERY NIGHT THE\NCHILDREN WOULD WAKE
Dialogue: 0,0:00:01.26,0:00:02.60,Cap,,0,0,0,,AT THE STRIKE OF\NTWELVE TO
Dialogue: 0,0:00:02.60,0:00:04.50,Cap,,0,0,0,,HE CREATED A LITTLE\NGOLEM,
Dialogue: 0,0:00:04.50,0:00:06.19,Cap,,0,0,0,,DOLL IN HIS OWN IMAGE.
Dialogue: 0,0:00:06.66,0:00:07.88,Cap,,0,0,0,,WITHIN EACH ONE OF\NTHESE HE
Dialogue: 0,0:00:07.88,0:00:09.66,Cap,,0,0,0,,PLACED A SPECIAL STONE\NCONTAINING HIS
Dialogue: 0,0:00:09.66,0:00:11.28,Cap,,0,0,0,,SPIRIT, AND WITH THIS\NUNION OF
Dialogue: 0,0:00:11.28,0:00:12.42,Cap,,0,0,0,,STONE AND POPPET,
Dialogue: 0,0:00:12.42,0:00:14.22,Cap,,0,0,0,,A MAGICAL FORMULATION\NOCCURRED,
Dialogue: 0,0:00:14.22,0:00:15.98,Cap,,0,0,0,,CREATING A POWERFUL\NSPELL OF PURE
Dialogue: 0,0:00:15.98,0:00:16.75,Cap,,0,0,0,,OBSESSION.
Dialogue: 0,0:00:17.06,0:00:18.92,Cap,,0,0,0,,NOW EVERYONE IN THE\NVILLAGE DESIRED
Dialogue: 0,0:00:18.92,0:00:20.10,Cap,,0,0,0,,THE DOLL AS A SHOWING\NOF
Dialogue: 0,0:00:20.10,0:00:20.97,Cap,,0,0,0,,THEIR STATUS.
Dialogue: 0,0:00:21.10,0:00:22.12,Cap,,0,0,0,,THEY DID NOT WANT FOR\NFOOD
Dialogue: 0,0:00:22.12,0:00:22.94,Cap,,0,0,0,,OR GOLD,
Dialogue: 0,0:00:22.94,0:00:23.99,Cap,,0,0,0,,ONLY THE DOLL,
Dialogue: 0,0:00:24.08,0:00:25.05,Cap,,0,0,0,,ONLY LA BOUX.
Dialogue: 0,0:00:28.36,0:00:30.25,Cap,,0,0,0,,WITH ALL GOING AS\NPLANNED,
Dialogue: 0,0:00:30.42,0:00:31.96,Cap,,0,0,0,,EVERY HOME IN THE\NVILLAGE NOW
Dialogue: 0,0:00:31.96,0:00:33.98,Cap,,0,0,0,,POSSESSED A DEMON DOLL\NOF THEIR
Dialogue: 0,0:00:33.98,0:00:34.97,Cap,,0,0,0,,VERY OWN.
Dialogue: 0,0:00:42.24,0:00:43.86,Cap,,0,0,0,,EVERY NIGHT THE\NCHILDREN WOULD WAKE
Dialogue: 0,0:00:43.86,0:00:45.36,Cap,,0,0,0,,AT THE STRIKE OF\NTWELVE TO
Dialogue: 0,0:00:45.36,0:00:47.42,Cap,,0,0,0,,PRACTICE THE SACRED\NHYMN IN PREPARATION
Dialogue: 0,0:00:47.42,0:00:49.88,Cap,,0,0,0,,FOR AN UPCOMING LUNAR\NCEREMONY,
Dialogue: 0,0:00:49.88,0:00:52.96,Cap,,0,0,0,,AN OCCULTATION KNOWN\NSPECIFICALLY AS BLOOD
Dialogue: 0,0:00:52.96,0:00:53.73,Cap,,0,0,0,,MOON.
Dialogue: 0,0:00:54.18,0:00:56.65,Cap,,0,0,0,,PAZUZU, PAZUZU,
Dialogue: 0,0:00:56.78,0:00:59.03,Cap,,0,0,0,,PAZUZU,
Dialogue: 0,0:00:59.28,0:01:00.51,Cap,,0,0,0,,PAZUZU,
Dialogue: 0,0:01:00.94,0:01:02.92,Cap,,0,0,0,,SON OF HANPA,
Dialogue: 0,0:01:02.92,0:01:05.52,Cap,,0,0,0,,KING OF THE EVIL\NSPIRITS OF
Dialogue: 0,0:01:05.52,0:01:06.18,Cap,,0,0,0,,THE AIR.
Dialogue: 0,0:01:06.18,0:01:09.24,Cap,,0,0,0,,HE WHO RAGES FIERCELY\NFROM THE
Dialogue: 0,0:01:09.24,0:01:11.83,Cap,,0,0,0,,MOUNTAINS, RETURN TO\NUS.
Dialogue: 0,0:01:15.08,0:01:16.96,Cap,,0,0,0,,WITH ALL THE CHILDREN\NSINGING THE
Dialogue: 0,0:01:16.96,0:01:18.00,Cap,,0,0,0,,DEMON ANTHEM,
Dialogue: 0,0:01:18.00,0:01:20.48,Cap,,0,0,0,,PAZUZU WAS FINALLY\NGRANTED ACCESS TO
Dialogue: 0,0:01:20.48,0:01:21.59,Cap,,0,0,0,,THE HELL PORTAL,
Dialogue: 0,0:01:21.72,0:01:23.36,Cap,,0,0,0,,A POSITION HE HAD\NALWAYS DESIRED
Dialogue: 0,0:01:23.36,0:01:24.76,Cap,,0,0,0,,IN ORDER TO GAIN HIS\NTRUE
Dialogue: 0,0:01:24.76,0:01:26.75,Cap,,0,0,0,,FORM ONCE AND FOR ALL.
Dialogue: 0,0:01:32.68,0:01:34.48,Cap,,0,0,0,,AND SO HE RETURNED TO\NTHE
Dialogue: 0,0:01:34.48,0:01:36.76,Cap,,0,0,0,,UNDERWORLD, TAKING\NEVERY CHILD OF THE
Dialogue: 0,0:01:36.76,0:01:37.93,Cap,,0,0,0,,VILLAGE WITH HIM.
Dialogue: 0,0:01:44.73,0:01:46.91,Cap,,0,0,0,,AND I'M SURE THEY ALL\NLIVED
Dialogue: 0,0:01:46.91,0:01:48.88,Cap,,0,0,0,,HAPPILY EVER AFTER.
Dialogue: 0,0:01:49.45,0:01:52.21,Cap,,0,0,0,,THE TOWNSPEOPLE HAVING\NBEEN UNBURDENED FROM
Dialogue: 0,0:01:52.21,0:01:54.99,Cap,,0,0,0,,THE SHACKLES OF\NPARENTHOOD SOUNDS JUST
Dialogue: 0,0:01:54.99,0:01:56.98,Cap,,0,0,0,,DIVINE IF I DO SAY SO.
Dialogue: 0,0:01:57.23,0:01:58.22,Cap,,0,0,0,,FOR
Dialogue: 0,0:02:05.04,0:02:05.93,Cap,,0,0,0,,HEAVENS,
Dialogue: 0,0:02:06.44,0:02:08.38,Cap,,0,0,0,,EVEN IN THIS STATE\NBARBELO IS
Dialogue: 0,0:02:08.38,0:02:10.57,Cap,,0,0,0,,AS IRRESISTIBLE AS\NALWAYS.
Dialogue: 3,0:02:09.54,0:02:12.74,End,,0,0,0,,{\fad(200,0)}PART 4\NTOMORROW
