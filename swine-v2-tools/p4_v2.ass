Dialogue: 2,0:00:00.00,0:00:02.60,Hook,,0,0,0,,{\fad(80,150)\t(0,250,\fscx106\fscy106)}DON'T LOOK\NINTO HIS EYES
Dialogue: 1,0:00:00.00,0:02:13.66,Tag,,0,0,0,,SWINE · PART 4 OF 8
Dialogue: 0,0:00:00.00,0:00:00.49,Cap,,0,0,0,,DON'T RESIST.
Dialogue: 0,0:00:00.80,0:00:02.28,Cap,,0,0,0,,JUST LISTEN TO THE\NSOUND OF
Dialogue: 0,0:00:02.28,0:00:02.60,Cap,,0,0,0,,MY VOICE.
Dialogue: 0,0:00:05.11,0:00:06.79,Cap,,0,0,0,,WELL, I MUST SAY,
Dialogue: 0,0:00:06.79,0:00:08.69,Cap,,0,0,0,,HE WAS A WRETCHED\NLORD,
Dialogue: 0,0:00:08.69,0:00:11.63,Cap,,0,0,0,,BUT A DELIGHTFULLY\NENTERTAINING\NCENTERPIECE.
Dialogue: 0,0:00:11.63,0:00:12.34,Cap,,0,0,0,,AH,
Dialogue: 0,0:00:20.36,0:00:21.15,Cap,,0,0,0,,MESMER.
Dialogue: 0,0:00:21.76,0:00:23.21,Cap,,0,0,0,,PUNCTUAL AS EVER.
Dialogue: 0,0:00:37.06,0:00:38.57,Cap,,0,0,0,,GOOD AND ARBENT.
Dialogue: 0,0:00:39.18,0:00:41.17,Cap,,0,0,0,,NOW, TAKE A DEEP\NBREATH IN,
Dialogue: 0,0:00:43.64,0:00:44.99,Cap,,0,0,0,,HOLD IT,
Dialogue: 0,0:00:45.44,0:00:46.75,Cap,,0,0,0,,BREATHE OUT,
Dialogue: 0,0:00:49.21,0:00:51.30,Cap,,0,0,0,,RELAX AND LOOK INTO\NTHE CENTER.
Dialogue: 0,0:00:51.45,0:00:52.47,Cap,,0,0,0,,DOWN, DOWN,
Dialogue: 0,0:00:52.47,0:00:54.35,Cap,,0,0,0,,DOWN. WITH EACH BREATH\NYOU WILL
Dialogue: 0,0:00:54.35,0:00:55.85,Cap,,0,0,0,,FEEL YOUR BODY\NBECOMING MORE AND
Dialogue: 0,0:00:55.85,0:00:56.98,Cap,,0,0,0,,MORE AT EASE.
Dialogue: 0,0:00:57.33,0:00:58.89,Cap,,0,0,0,,YOU WILL NOTICE HOW\NGOOD YOU
Dialogue: 0,0:00:58.89,0:00:59.70,Cap,,0,0,0,,FEEL.
Dialogue: 0,0:01:00.35,0:01:01.60,Cap,,0,0,0,,DOWN, DOWN,
Dialogue: 0,0:01:01.63,0:01:02.30,Cap,,0,0,0,,DOWN.
Dialogue: 0,0:01:02.69,0:01:03.86,Cap,,0,0,0,,NOW LET GO.
Dialogue: 0,0:01:04.37,0:01:05.12,Cap,,0,0,0,,SLEEP.
Dialogue: 0,0:01:11.70,0:01:12.63,Cap,,0,0,0,,THAT'S IT.
Dialogue: 0,0:01:13.12,0:01:15.13,Cap,,0,0,0,,DEEPER AND DEEPER.
Dialogue: 0,0:01:15.14,0:01:16.09,Cap,,0,0,0,,DON'T RESIST.
Dialogue: 0,0:01:16.40,0:01:17.88,Cap,,0,0,0,,JUST LISTEN TO THE\NSOUND OF
Dialogue: 0,0:01:17.88,0:01:18.87,Cap,,0,0,0,,MY VOICE.
Dialogue: 0,0:01:20.59,0:01:22.25,Cap,,0,0,0,,DOES IT NOT FEEL GOOD\NTO
Dialogue: 0,0:01:22.25,0:01:23.64,Cap,,0,0,0,,RELINQUISH CONTROL?
Dialogue: 0,0:01:24.31,0:01:26.31,Cap,,0,0,0,,IT'S SO EASY TO JUST\NSLIP
Dialogue: 0,0:01:26.31,0:01:27.06,Cap,,0,0,0,,AWAY.
Dialogue: 0,0:01:27.91,0:01:29.52,Cap,,0,0,0,,DOWN, DOWN,
Dialogue: 0,0:01:29.61,0:01:30.28,Cap,,0,0,0,,DOWN.
Dialogue: 0,0:01:39.52,0:01:41.04,Cap,,0,0,0,,I WANT YOU TO\NVISUALIZE A
Dialogue: 0,0:01:41.04,0:01:42.72,Cap,,0,0,0,,VERY SPECIAL PLACE\NTHAT HAS BEEN
Dialogue: 0,0:01:42.72,0:01:43.84,Cap,,0,0,0,,HIDING IN THE BACK OF\NYOUR
Dialogue: 0,0:01:43.84,0:01:44.63,Cap,,0,0,0,,MEMORIES.
Dialogue: 0,0:01:46.08,0:01:47.79,Cap,,0,0,0,,YOU'VE BEEN THERE\NBEFORE.
Dialogue: 0,0:01:48.76,0:01:50.33,Cap,,0,0,0,,YOU JUST NEED TO\NREMEMBER.
Dialogue: 0,0:01:52.31,0:01:54.64,Cap,,0,0,0,,DEEPER AND DEEPER.
Dialogue: 0,0:01:55.23,0:01:56.89,Cap,,0,0,0,,IN YOUR MIND'S EYE YOU\NWILL
Dialogue: 0,0:01:56.89,0:01:58.48,Cap,,0,0,0,,SEE US THERE TOGETHER.
Dialogue: 0,0:01:59.63,0:02:00.62,Cap,,0,0,0,,NOW,
Dialogue: 0,0:02:01.37,0:02:02.36,Cap,,0,0,0,,SEE.
Dialogue: 3,0:02:10.46,0:02:13.66,End,,0,0,0,,{\fad(200,0)}PART 5\NTOMORROW
