Dialogue: 2,0:00:00.00,0:00:02.60,Hook,,0,0,0,,{\fad(80,150)\t(0,250,\fscx106\fscy106)}NEVER LIE\NTO HER
Dialogue: 1,0:00:00.00,0:01:57.99,Tag,,0,0,0,,SWINE · PART 6 OF 8
Dialogue: 0,0:00:00.74,0:00:02.60,Cap,,0,0,0,,SO AS A DIVINE\NEMISSARY,
Dialogue: 0,0:00:17.62,0:00:18.65,Cap,,0,0,0,,WORM.
Dialogue: 0,0:00:19.00,0:00:20.13,Cap,,0,0,0,,I MEAN,
Dialogue: 0,0:00:20.20,0:00:21.35,Cap,,0,0,0,,CHOSEN ONE.
Dialogue: 0,0:00:22.46,0:00:23.81,Cap,,0,0,0,,I KNEW YOU WOULD COME.
Dialogue: 0,0:00:24.56,0:00:25.78,Cap,,0,0,0,,IT IS NOT EVERY DAY\NONE
Dialogue: 0,0:00:25.78,0:00:27.50,Cap,,0,0,0,,HAS THE OPPORTUNITY TO\NCOMMUNE WITH
Dialogue: 0,0:00:27.50,0:00:28.13,Cap,,0,0,0,,GOD.
Dialogue: 0,0:00:41.34,0:00:43.30,Cap,,0,0,0,,SO AS A DIVINE\NEMISSARY,
Dialogue: 0,0:00:43.30,0:00:44.93,Cap,,0,0,0,,WHAT IS YOUR TRUE\NPURPOSE?
Dialogue: 0,0:00:45.90,0:00:47.44,Cap,,0,0,0,,YOU HAVE BEEN GIFTED\NTHE LOGOS,
Dialogue: 0,0:00:47.44,0:00:48.23,Cap,,0,0,0,,HAVE YOU NOT?
Dialogue: 0,0:00:48.80,0:00:50.48,Cap,,0,0,0,,ANOINTED BY THE ONE\NTRUE HAND,
Dialogue: 0,0:00:50.48,0:00:51.05,Cap,,0,0,0,,YES?
Dialogue: 0,0:01:02.72,0:01:03.93,Cap,,0,0,0,,CAT GOT YOUR TONGUE?
Dialogue: 0,0:01:04.52,0:01:05.39,Cap,,0,0,0,,NO MATTER.
Dialogue: 0,0:01:06.16,0:01:08.05,Cap,,0,0,0,,WORM TOOK MY HANDS.
Dialogue: 0,0:01:09.78,0:01:10.86,Cap,,0,0,0,,TIT FOR TAT,
Dialogue: 0,0:01:10.86,0:01:11.59,Cap,,0,0,0,,I SUPPOSE.
Dialogue: 0,0:01:12.12,0:01:13.60,Cap,,0,0,0,,ALL IS FAIR IN LOVE\NAND
Dialogue: 0,0:01:13.60,0:01:14.89,Cap,,0,0,0,,WAR AFTER ALL.
Dialogue: 0,0:01:18.30,0:01:20.37,Cap,,0,0,0,,SO MY SWEET LITTLE\NPARASITE,
Dialogue: 0,0:01:21.92,0:01:23.29,Cap,,0,0,0,,WHEN YOU MUST CHOOSE,
Dialogue: 0,0:01:23.90,0:01:24.80,Cap,,0,0,0,,DO TRY NOT TO MAKE THE
Dialogue: 0,0:01:24.80,0:01:26.58,Cap,,0,0,0,,SAME MISTAKES TWICE\NLEST YOU BE
Dialogue: 0,0:01:26.58,0:01:28.65,Cap,,0,0,0,,DOOMED TO REPEATING\NTHE PATTERN OVER.
Dialogue: 0,0:01:29.18,0:01:31.04,Cap,,0,0,0,,WORM'S WORK ALWAYS\NCOMES WITH A
Dialogue: 0,0:01:31.04,0:01:32.81,Cap,,0,0,0,,PRICE. I'M NOT A\NPARASITE.
Dialogue: 0,0:01:33.10,0:01:33.75,Cap,,0,0,0,,SEE?
Dialogue: 0,0:01:37.44,0:01:39.60,Cap,,0,0,0,,THERE IS NO GREATER\NMOTIVATOR THAN
Dialogue: 0,0:01:39.60,0:01:40.87,Cap,,0,0,0,,FEAR, MY DEAR.
Dialogue: 0,0:01:45.13,0:01:46.00,Cap,,0,0,0,,ARE YOU HUNGRY?
Dialogue: 0,0:01:46.37,0:01:47.22,Cap,,0,0,0,,NO.
Dialogue: 0,0:01:47.55,0:01:48.22,Cap,,0,0,0,,WHAT?
Dialogue: 0,0:01:48.59,0:01:50.45,Cap,,0,0,0,,THE VILLAGERS HAVE\NPROVIDED YOU AN
Dialogue: 0,0:01:50.45,0:01:51.72,Cap,,0,0,0,,AMPLE FEAST.
Dialogue: 0,0:01:52.41,0:01:53.47,Cap,,0,0,0,,IF YOU ARE IN NO\NLONGER
Dialogue: 0,0:01:53.47,0:01:54.31,Cap,,0,0,0,,NEED OF FOOD,
Dialogue: 0,0:01:54.31,0:01:55.47,Cap,,0,0,0,,YOU MIGHT CONSIDER\NGIVING IT BACK
Dialogue: 0,0:01:55.47,0:01:57.41,Cap,,0,0,0,,TO THEM WITH THE\NSHORTAGE AND
Dialogue: 0,0:01:57.41,0:01:57.99,Cap,,0,0,0,,SUCH.
Dialogue: 3,0:01:54.79,0:01:57.99,End,,0,0,0,,{\fad(200,0)}PART 7\NTOMORROW
