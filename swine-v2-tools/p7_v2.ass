Dialogue: 2,0:00:00.00,0:00:02.60,Hook,,0,0,0,,{\fad(80,150)\t(0,250,\fscx106\fscy106)}SHE'S THE\NCHOSEN ONE\NNOW
Dialogue: 1,0:00:00.00,0:03:26.73,Tag,,0,0,0,,SWINE · PART 7 OF 8
Dialogue: 0,0:00:03.78,0:00:04.61,Cap,,0,0,0,,OH.
Dialogue: 0,0:00:05.38,0:00:06.93,Cap,,0,0,0,,YOU MEAN CHARITY?
Dialogue: 0,0:00:08.50,0:00:09.28,Cap,,0,0,0,,NO, SIR.
Dialogue: 0,0:00:09.28,0:00:10.42,Cap,,0,0,0,,THEY ARE SIMPLY ASKING\NFOR WHAT
Dialogue: 0,0:00:10.42,0:00:12.32,Cap,,0,0,0,,YOU TOOK TO BE\NRETURNED IF
Dialogue: 0,0:00:12.32,0:00:13.16,Cap,,0,0,0,,YOU ARE NOT GOING TO\NEAT
Dialogue: 0,0:00:13.16,0:00:13.67,Cap,,0,0,0,,IT.
Dialogue: 0,0:00:18.49,0:00:19.99,Cap,,0,0,0,,THEY HAVE ALREADY HAVE\NBEEN PAID.
Dialogue: 0,0:00:19.99,0:00:21.28,Cap,,0,0,0,,THEY HAVE BEEN GIVEN\NTHE DOLLS.
Dialogue: 0,0:00:21.81,0:00:23.01,Cap,,0,0,0,,I DON'T THINK THEY\NHAVE WORKED
Dialogue: 0,0:00:23.01,0:00:23.84,Cap,,0,0,0,,HARD ENOUGH.
Dialogue: 0,0:00:42.50,0:00:44.11,Cap,,0,0,0,,DON'T BOTHER WITH HER.
Dialogue: 0,0:00:44.52,0:00:45.83,Cap,,0,0,0,,SHE'S CHOSEN.
Dialogue: 0,0:00:47.10,0:00:48.29,Cap,,0,0,0,,OH, YES.
Dialogue: 0,0:00:48.80,0:00:49.57,Cap,,0,0,0,,INDEED,
Dialogue: 0,0:00:49.96,0:00:51.98,Cap,,0,0,0,,NOT MUCH OF A\NSACRIFICE IF
Dialogue: 0,0:00:51.98,0:00:53.04,Cap,,0,0,0,,YOU ASK ME.
Dialogue: 0,0:00:53.04,0:00:54.43,Cap,,0,0,0,,AND
Dialogue: 0,0:00:58.88,0:01:01.44,Cap,,0,0,0,,SO, HAVING RETURNED TO\NTHE BLOOD
Dialogue: 0,0:01:01.44,0:01:04.48,Cap,,0,0,0,,MOON FESTIVITIES\NWITHOUT A CARE IN
Dialogue: 0,0:01:04.48,0:01:05.45,Cap,,0,0,0,,THE WORLD,
Dialogue: 0,0:01:05.86,0:01:07.41,Cap,,0,0,0,,CHOICES WERE MADE,
Dialogue: 0,0:01:07.62,0:01:09.81,Cap,,0,0,0,,CONSCIOUSLY OR NOT.
Dialogue: 0,0:01:11.34,0:01:12.13,Cap,,0,0,0,,YOU SEE,
Dialogue: 0,0:01:12.54,0:01:14.84,Cap,,0,0,0,,OUR GODS FORGOT THE\NMOST IMPORTANT
Dialogue: 0,0:01:14.84,0:01:16.29,Cap,,0,0,0,,RULE OF ALL,
Dialogue: 0,0:01:16.78,0:01:17.81,Cap,,0,0,0,,AS ABOVE,
Dialogue: 0,0:01:18.00,0:01:19.07,Cap,,0,0,0,,SO BELOW.
Dialogue: 0,0:01:19.82,0:01:21.97,Cap,,0,0,0,,AND DOWN HERE IN THE\NDARK,
Dialogue: 0,0:01:22.54,0:01:25.31,Cap,,0,0,0,,THE WORM'S WORK IS\NNEVER DONE.
Dialogue: 0,0:01:27.58,0:01:29.13,Cap,,0,0,0,,OH, YES.
Dialogue: 0,0:01:29.28,0:01:30.71,Cap,,0,0,0,,I MUST SHOW YOU\NSOMETHING.
Dialogue: 0,0:01:30.74,0:01:31.42,Cap,,0,0,0,,LOOK, LOOK,
Dialogue: 0,0:01:31.42,0:01:34.35,Cap,,0,0,0,,SHH. HE'S JUST PERFECT\NFOR YOU,
Dialogue: 0,0:01:40.24,0:01:42.21,Cap,,0,0,0,,SOMETHING TO BRING MY\NGUST AROUND.
Dialogue: 0,0:01:43.64,0:01:45.08,Cap,,0,0,0,,AND JUST WHERE DID YOU\NGET
Dialogue: 0,0:01:45.08,0:01:45.76,Cap,,0,0,0,,LA BOUX?
Dialogue: 0,0:01:45.76,0:01:47.35,Cap,,0,0,0,,HE IS FOR THE\NTOWNSPEOPLE.
Dialogue: 0,0:01:49.38,0:01:51.08,Cap,,0,0,0,,WHY, SHE STOLE IT,
Dialogue: 0,0:01:51.08,0:01:51.85,Cap,,0,0,0,,OF COURSE,
Dialogue: 0,0:01:52.10,0:01:53.83,Cap,,0,0,0,,OUR LITTLE CHOSEN ONE.
Dialogue: 0,0:02:07.55,0:02:09.18,Cap,,0,0,0,,WHAT A LITTLE
Dialogue: 0,0:02:24.25,0:02:26.65,Cap,,0,0,0,,LAMB. HOW IN HEAVEN'S\NNAME DID
Dialogue: 0,0:02:26.65,0:02:27.27,Cap,,0,0,0,,YOU GET IN HERE?
Dialogue: 0,0:02:27.27,0:02:29.23,Cap,,0,0,0,,WE MUST NOT LET THESE\NMONSTERS
Dialogue: 0,0:02:29.23,0:02:30.76,Cap,,0,0,0,,FRIGHTEN YOU.
Dialogue: 0,0:02:38.01,0:02:40.74,Cap,,0,0,0,,DID YOU PLEASE STORE\NIT?
Dialogue: 0,0:02:41.33,0:02:42.18,Cap,,0,0,0,,SURVIVE?
Dialogue: 0,0:03:14.22,0:03:15.26,Cap,,0,0,0,,IT IS SAID WE ARE TO
Dialogue: 0,0:03:15.26,0:03:16.79,Cap,,0,0,0,,FEAR THE BREATH OF\NGOD.
Dialogue: 0,0:03:17.56,0:03:19.54,Cap,,0,0,0,,YET THE SENSES DELIGHT\NAS IT
Dialogue: 0,0:03:19.54,0:03:21.32,Cap,,0,0,0,,FILLS THE LUNGS AND\NMIND,
Dialogue: 0,0:03:21.32,0:03:22.13,Cap,,0,0,0,,DOES IT NOT?
Dialogue: 0,0:03:22.14,0:03:23.97,Cap,,0,0,0,,INDEED, MY LORD,
Dialogue: 0,0:03:24.44,0:03:26.00,Cap,,0,0,0,,A BEAUTIFUL EULOGY,
Dialogue: 0,0:03:26.00,0:03:26.65,Cap,,0,0,0,,TRULY.
Dialogue: 3,0:03:23.53,0:03:26.73,End,,0,0,0,,{\fad(200,0)}PART 8\NTOMORROW
