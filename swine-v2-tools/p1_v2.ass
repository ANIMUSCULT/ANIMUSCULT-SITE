Dialogue: 2,0:00:00.00,0:00:02.60,Hook,,0,0,0,,{\fad(80,150)\t(0,250,\fscx106\fscy106)}DINNER IS STILL\NBREATHING
Dialogue: 1,0:00:00.00,0:02:54.35,Tag,,0,0,0,,SWINE · PART 1 OF 8
Dialogue: 0,0:00:01.21,0:00:02.60,Cap,,0,0,0,,DON'T KNOW WHAT THEY\NKEEP COMPLAINING
Dialogue: 0,0:00:11.50,0:00:14.04,Cap,,0,0,0,,LEGENDARY. YOU'VE\NOUTDONE YOURSELVES,
Dialogue: 0,0:00:14.04,0:00:15.37,Cap,,0,0,0,,AND
Dialogue: 0,0:00:17.10,0:00:18.34,Cap,,0,0,0,,HOW DID YOU PREPARE\NTHE GREAT
Dialogue: 0,0:00:18.34,0:00:19.33,Cap,,0,0,0,,PATHFINDER?
Dialogue: 0,0:00:19.84,0:00:22.05,Cap,,0,0,0,,I PREFER MY SWINE RAW,
Dialogue: 0,0:00:22.20,0:00:23.46,Cap,,0,0,0,,BUT WE WOULDN'T WANT\NTO CATCH
Dialogue: 0,0:00:23.46,0:00:24.85,Cap,,0,0,0,,THE FRUIT OF THE WORM.
Dialogue: 0,0:00:25.06,0:00:25.67,Cap,,0,0,0,,THOUGH
Dialogue: 0,0:00:33.13,0:00:34.47,Cap,,0,0,0,,I STOOD UP AND TOLD\NALL
Dialogue: 0,0:00:34.47,0:00:34.87,Cap,,0,0,0,,OF THEM,
Dialogue: 0,0:00:34.87,0:00:35.21,Cap,,0,0,0,,NO, NO,
Dialogue: 0,0:00:35.21,0:00:36.74,Cap,,0,0,0,,NO, THIS WON'T DO.
Dialogue: 0,0:00:36.81,0:00:38.53,Cap,,0,0,0,,WE CANNOT HAVE THE\NSERVANTS EATING
Dialogue: 0,0:00:38.53,0:00:39.72,Cap,,0,0,0,,IN OUR COURTYARD.
Dialogue: 0,0:00:39.91,0:00:41.11,Cap,,0,0,0,,IT'S A PUBLIC SPACE,
Dialogue: 0,0:00:41.11,0:00:42.62,Cap,,0,0,0,,IT'S SO UNSIGHTLY.
Dialogue: 0,0:00:42.95,0:00:44.17,Cap,,0,0,0,,WE PAY THEM TO WORK,
Dialogue: 0,0:00:44.17,0:00:45.20,Cap,,0,0,0,,NOT EAT.
Dialogue: 0,0:00:48.15,0:00:49.02,Cap,,0,0,0,,I
Dialogue: 0,0:00:59.81,0:01:01.31,Cap,,0,0,0,,DON'T KNOW WHAT THEY\NKEEP COMPLAINING
Dialogue: 0,0:01:01.31,0:01:03.55,Cap,,0,0,0,,ABOUT. WE'VE ALREADY\NPROVIDED A LA
Dialogue: 0,0:01:03.55,0:01:05.58,Cap,,0,0,0,,BOUX TO EACH AND EVERY\NHOUSEHOLD.
Dialogue: 0,0:01:05.59,0:01:06.89,Cap,,0,0,0,,YES, YES CHAMBERLAIN,
Dialogue: 0,0:01:06.89,0:01:07.95,Cap,,0,0,0,,THEY CAN SIMPLY EAT LA\NBOUX
Dialogue: 0,0:01:07.95,0:01:09.04,Cap,,0,0,0,,FOR ALL YOU CARE.
Dialogue: 0,0:01:25.77,0:01:27.50,Cap,,0,0,0,,SPEAKING OF WORM\NFRUIT,
Dialogue: 0,0:01:27.79,0:01:29.73,Cap,,0,0,0,,GENTLEMEN, MAY I\NPRESENT TO YOU
Dialogue: 0,0:01:29.73,0:01:32.46,Cap,,0,0,0,,IN ITS PUREST AND\NUNADULTERATED FORM,
Dialogue: 0,0:01:32.63,0:01:34.01,Cap,,0,0,0,,THE HOLY CHRISTOS,
Dialogue: 0,0:01:34.01,0:01:35.49,Cap,,0,0,0,,ACQUIRED BY MY OWN\NHAND FROM
Dialogue: 0,0:01:35.49,0:01:37.20,Cap,,0,0,0,,OUR FRIEND BARBELO\NHERE.
Dialogue: 0,0:01:37.55,0:01:38.97,Cap,,0,0,0,,NOW GATHER ROUND WHILE\NI ANOINT
Dialogue: 0,0:01:38.97,0:01:40.60,Cap,,0,0,0,,EACH AND EVERY ONE OF\NYOU.
Dialogue: 0,0:01:42.72,0:01:44.23,Cap,,0,0,0,,NO NEED TO RUSH.
Dialogue: 0,0:01:45.48,0:01:47.12,Cap,,0,0,0,,THERE'S ENOUGH FOR\NEVERYONE TO BE
Dialogue: 0,0:01:47.12,0:01:48.62,Cap,,0,0,0,,A GOD WITH ME TONIGHT,
Dialogue: 0,0:01:48.62,0:01:50.31,Cap,,0,0,0,,EVEN YOU CHANCELLOR.
Dialogue: 0,0:01:56.48,0:01:57.69,Cap,,0,0,0,,AH YES,
Dialogue: 0,0:01:58.26,0:01:59.48,Cap,,0,0,0,,AND WHEN THE CLOCK\NSTRIKES THE
Dialogue: 0,0:01:59.48,0:02:00.58,Cap,,0,0,0,,HOUR, WHO SHALL BE THE\NCHOSEN
Dialogue: 0,0:02:00.58,0:02:01.19,Cap,,0,0,0,,ONE?
Dialogue: 0,0:02:01.56,0:02:02.45,Cap,,0,0,0,,GOD,
Dialogue: 0,0:02:02.74,0:02:03.72,Cap,,0,0,0,,I HAVE YET TO SEE YOU
Dialogue: 0,0:02:03.72,0:02:05.83,Cap,,0,0,0,,MANIFEST ANYTHING\NBEYOND YOUR OWN\NDELUSIONS,
Dialogue: 0,0:02:05.90,0:02:06.67,Cap,,0,0,0,,BUT PLEASE,
Dialogue: 0,0:02:06.86,0:02:07.61,Cap,,0,0,0,,CONTINUE.
Dialogue: 0,0:02:08.08,0:02:09.68,Cap,,0,0,0,,I DO ENJOY YOUR\NSUBVERSIVE NATURE
Dialogue: 0,0:02:09.68,0:02:10.67,Cap,,0,0,0,,AFTER ALL.
Dialogue: 0,0:02:24.33,0:02:26.21,Cap,,0,0,0,,I SUPPOSE YOU'D SEE\NYOURSELF CHOSEN
Dialogue: 0,0:02:26.21,0:02:27.04,Cap,,0,0,0,,WOULD YOU NOT?
Dialogue: 0,0:02:27.35,0:02:28.31,Cap,,0,0,0,,WELL YOU ARE IN LUCK.
Dialogue: 0,0:02:28.31,0:02:30.43,Cap,,0,0,0,,YES, I DO BELIEVE\NTONIGHT YOU
Dialogue: 0,0:02:30.43,0:02:32.00,Cap,,0,0,0,,MAY INDEED BE CHOSEN.
Dialogue: 0,0:02:32.43,0:02:34.07,Cap,,0,0,0,,PERHAPS NOT FOR\NREASONS THAT ARE
Dialogue: 0,0:02:34.07,0:02:37.12,Cap,,0,0,0,,CLEAR, BUT NO BUTS.
Dialogue: 0,0:02:37.33,0:02:40.44,Cap,,0,0,0,,A TOAST TO BUCKUS THE\NWORMLORD!
Dialogue: 3,0:02:51.15,0:02:54.35,End,,0,0,0,,{\fad(200,0)}PART 2\NTOMORROW
